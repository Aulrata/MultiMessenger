@page "/integrations"
@attribute [Authorize(Policy = AuthorizationPolicies.Workspace)]

@using System.ComponentModel.DataAnnotations
@using MultiMessenger.Core.Entities
@using MultiMessenger.Core.Messaging
@using MultiMessenger.Infrastructure.Messengers

@inject MessengerAccountService Accounts
@inject NavigationManager Navigation

@* Страница статическая: шаги входа — это отдельные отправки формы, живое
   соединение с Telegram живёт не здесь, а в PendingLoginStore. Заодно доступен
   HttpContext, из которого берётся адрес для журнала аудита. *@

<PageTitle>Интеграции — MultiMessenger</PageTitle>

<h1 class="h4 mb-4">Интеграции</h1>

<div class="row g-4">
    <div class="col-lg-6">
        <h2 class="h6 mb-3">Подключённые каналы</h2>

        @if (_accounts.Count == 0)
        {
            <p class="text-body-secondary">Пока ни одного канала не подключено.</p>
        }
        else
        {
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Платформа</th>
                        <th scope="col">Номер</th>
                        <th scope="col">Состояние</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in _accounts)
                    {
                        <tr>
                            <td>@account.Platform</td>
                            <td>@account.PhoneNumber</td>
                            <td>@StatusText(account.Status)</td>
                            <td class="text-end">
                                @if (account.Status is MessengerAccountStatus.Active
                                    or MessengerAccountStatus.Disconnected
                                    or MessengerAccountStatus.RequiresReauth)
                                {
                                    <form method="post" @formname="@($"disconnect-{account.Id}")"
                                          @onsubmit="() => DisconnectAsync(account.Id)">
                                        <AntiforgeryToken />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Отключить</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <h2 class="h6 mb-3">Подключить Telegram</h2>

                @if (_message is not null)
                {
                    <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") py-2">@_message</div>
                }

                @switch (_step)
                {
                    case LoginStep.NeedsVerificationCode needsCode:
                        <p class="text-body-secondary small">
                            Telegram отправил код на @(needsCode.SentTo ?? "ваш номер").
                            Он приходит в само приложение Telegram, а не по SMS.
                        </p>

                        <EditForm Model="CodeInput" method="post" OnValidSubmit="SubmitCodeAsync" FormName="submit-code">
                            <DataAnnotationsValidator />
                            <input type="hidden" name="loginId" value="@_loginId" />

                            <div class="mb-3">
                                <label for="code" class="form-label">Код подтверждения</label>
                                <InputText id="code" class="form-control" @bind-Value="CodeInput.Code"
                                           autocomplete="one-time-code" inputmode="numeric" />
                                <ValidationMessage For="() => CodeInput.Code" class="text-danger small" />
                            </div>

                            <button type="submit" class="btn btn-primary">Подтвердить</button>
                            <button type="submit" class="btn btn-link" formaction="/integrations">Отмена</button>
                        </EditForm>

                        break;

                    case LoginStep.NeedsTwoFactorPassword needsPassword:
                        <p class="text-body-secondary small">
                            На аккаунте включена двухфакторная защита.
                            @if (needsPassword.Hint is { Length: > 0 } hint)
                            {
                                <text>Подсказка: @hint</text>
                            }
                        </p>

                        <EditForm Model="PasswordInput" method="post" OnValidSubmit="SubmitPasswordAsync" FormName="submit-password">
                            <DataAnnotationsValidator />
                            <input type="hidden" name="loginId" value="@_loginId" />

                            <div class="mb-3">
                                <label for="tfa" class="form-label">Пароль</label>
                                <InputText id="tfa" type="password" class="form-control" @bind-Value="PasswordInput.Password"
                                           autocomplete="current-password" />
                                <ValidationMessage For="() => PasswordInput.Password" class="text-danger small" />
                            </div>

                            <button type="submit" class="btn btn-primary">Войти</button>
                        </EditForm>

                        break;

                    default:
                        <EditForm Model="PhoneInput" method="post" OnValidSubmit="BeginLoginAsync" FormName="begin-login">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label for="phone" class="form-label">Номер телефона</label>
                                <InputText id="phone" class="form-control" @bind-Value="PhoneInput.PhoneNumber" />
                                <ValidationMessage For="() => PhoneInput.PhoneNumber" class="text-danger small" />
                                <div class="form-text">
                                    Рабочий номер, к которому привязан Telegram. Подставлен из вашего профиля.
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary">Получить код</button>
                        </EditForm>

                        break;
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<MessengerAccount> _accounts = [];
    private Guid _managerId;
    private LoginStep? _step;
    private Guid _loginId;
    private string? _message;
    private bool _messageIsError;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "begin-login")]
    private PhoneForm? _phoneForm { get; set; }

    [SupplyParameterFromForm(FormName = "submit-code")]
    private CodeForm? _codeForm { get; set; }

    [SupplyParameterFromForm(FormName = "submit-password")]
    private PasswordForm? _passwordForm { get; set; }

    [SupplyParameterFromQuery(Name = "loginId")]
    private Guid? LoginIdFromQuery { get; set; }

    private PhoneForm PhoneInput => _phoneForm ??= new PhoneForm();

    private CodeForm CodeInput => _codeForm ??= new CodeForm();

    private PasswordForm PasswordInput => _passwordForm ??= new PasswordForm();

    protected override async Task OnInitializedAsync()
    {
        _managerId = HttpContext.User.GetManagerId() ?? Guid.Empty;
        await ReloadAsync();

        if (string.IsNullOrWhiteSpace(PhoneInput.PhoneNumber))
        {
            // Номер менеджера — он же номер, к которому привязан Telegram.
            PhoneInput.PhoneNumber = _accounts
                .FirstOrDefault(account => account.Platform == MessengerPlatform.Telegram)?.PhoneNumber
                ?? HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.MobilePhone)?.Value
                ?? string.Empty;
        }
    }

    private async Task BeginLoginAsync()
    {
        var (loginId, step) = await Accounts.BeginLoginAsync(
            _managerId, MessengerPlatform.Telegram, PhoneInput.PhoneNumber, ClientIp);

        Apply(loginId, step);
        await ReloadAsync();
    }

    private async Task SubmitCodeAsync() =>
        await ContinueAsync(new LoginAnswer.VerificationCode(CodeInput.Code));

    private async Task SubmitPasswordAsync() =>
        await ContinueAsync(new LoginAnswer.TwoFactorPassword(PasswordInput.Password));

    private async Task ContinueAsync(LoginAnswer answer)
    {
        var submittedLoginId = ReadLoginIdFromForm();

        var (loginId, step) = await Accounts.ContinueLoginAsync(
            _managerId, submittedLoginId, answer, ClientIp);

        Apply(loginId, step);
        await ReloadAsync();
    }

    private async Task DisconnectAsync(Guid accountId)
    {
        await Accounts.DisconnectAsync(_managerId, accountId, ClientIp);

        _message = "Канал отключён";
        _messageIsError = false;
        _step = null;

        await ReloadAsync();
    }

    private void Apply(Guid loginId, LoginStep step)
    {
        _loginId = loginId;
        _step = step;

        switch (step)
        {
            case LoginStep.Completed:
                _message = "Telegram подключён";
                _messageIsError = false;
                _step = null;
                _codeForm = null;
                _passwordForm = null;
                break;

            case LoginStep.Failed failed:
                _message = Describe(failed);
                _messageIsError = true;
                _step = null;
                _codeForm = null;
                _passwordForm = null;
                break;

            default:
                _message = null;
                break;
        }
    }

    private static string Describe(LoginStep.Failed failed) => failed.Reason switch
    {
        LoginFailureReason.InvalidPhoneNumber => "Номер телефона в нераспознанном формате",
        LoginFailureReason.InvalidCode => "Неверный код подтверждения",
        LoginFailureReason.InvalidPassword => "Неверный пароль двухфакторной защиты",
        LoginFailureReason.Expired => failed.Details ?? "Код истёк, начните заново",
        LoginFailureReason.RateLimited => "Telegram временно ограничил попытки. Подождите и повторите",
        LoginFailureReason.AccountBanned => "Аккаунт заблокирован платформой",
        LoginFailureReason.NetworkError => "Нет связи с Telegram. Проверьте настройки прокси",
        _ => failed.Details ?? "Не удалось подключить канал",
    };

    /// <summary>
    /// Идентификатор попытки едет скрытым полем формы: страница статическая,
    /// между шагами состояние компонента не сохраняется.
    /// </summary>
    private Guid ReadLoginIdFromForm() =>
        Guid.TryParse(HttpContext.Request.Form["loginId"], out var parsed) ? parsed : LoginIdFromQuery ?? Guid.Empty;

    private string? ClientIp => HttpContext.Connection.RemoteIpAddress?.ToString();

    private async Task ReloadAsync() => _accounts = await Accounts.GetAccountsAsync(_managerId);

    private static string StatusText(MessengerAccountStatus status) => status switch
    {
        MessengerAccountStatus.Active => "Работает",
        MessengerAccountStatus.PendingAuth => "Вход не завершён",
        MessengerAccountStatus.Disconnected => "Отключён",
        MessengerAccountStatus.RequiresReauth => "Требуется повторный вход",
        _ => status.ToString(),
    };

    private sealed class PhoneForm
    {
        [Required(ErrorMessage = "Укажите номер телефона")]
        public string PhoneNumber { get; set; } = string.Empty;
    }

    private sealed class CodeForm
    {
        [Required(ErrorMessage = "Введите код из Telegram")]
        public string Code { get; set; } = string.Empty;
    }

    private sealed class PasswordForm
    {
        [Required(ErrorMessage = "Введите пароль")]
        public string Password { get; set; } = string.Empty;
    }
}
