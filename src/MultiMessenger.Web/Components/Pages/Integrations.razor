@page "/integrations"
@attribute [Authorize(Policy = AuthorizationPolicies.Workspace)]

@using System.ComponentModel.DataAnnotations
@using MultiMessenger.Core.Entities
@using MultiMessenger.Core.Messaging
@using MultiMessenger.Infrastructure.Messengers

@inject MessengerAccountService Accounts
@inject NavigationManager Navigation

@* Страница статическая, поэтому состояние шага не переживает запрос: при каждом
   POST компонент создаётся заново. Blazor ищет форму по имени ДО вызова
   обработчика, значит нужная форма обязана быть отрисована уже в этот момент —
   иначе «no form on the page currently has that name».

   Поэтому шаг и попытка едут в адресной строке: по ним страница знает, что
   рисовать, ещё до разбора формы. Побочная польза — обновление страницы
   не сбрасывает начатый вход. *@

<PageTitle>Интеграции — MultiMessenger</PageTitle>

<h1 class="h4 mb-4">Интеграции</h1>

<div class="row g-4">
    <div class="col-lg-6">
        <h2 class="h6 mb-3">Подключённые каналы</h2>

        @if (_accounts.Count == 0)
        {
            <p class="text-body-secondary">Пока ни одного канала не подключено.</p>
        }
        else
        {
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Платформа</th>
                        <th scope="col">Номер</th>
                        <th scope="col">Состояние</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in _accounts)
                    {
                        <tr>
                            <td>@account.Platform</td>
                            <td>@account.PhoneNumber</td>
                            <td>@StatusText(account.Status)</td>
                            <td class="text-end">
                                @if (account.Status is not MessengerAccountStatus.PendingAuth)
                                {
                                    <form method="post" @formname="@($"disconnect-{account.Id}")"
                                          @onsubmit="() => DisconnectAsync(account.Id)">
                                        <AntiforgeryToken />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Отключить</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <h2 class="h6 mb-3">Подключить Telegram</h2>

                @if (Notice is { } notice)
                {
                    <div class="alert @(IsError(notice) ? "alert-danger" : "alert-success") py-2">
                        @NoticeText(notice)
                    </div>
                }

                @if (Step == StepCode)
                {
                    <p class="text-body-secondary small">
                        Telegram отправил код подтверждения. Он приходит в само приложение Telegram,
                        а не по SMS.
                    </p>

                    <EditForm Model="CodeInput" method="post" OnValidSubmit="SubmitCodeAsync" FormName="submit-code">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label for="code" class="form-label">Код подтверждения</label>
                            <InputText id="code" class="form-control" @bind-Value="CodeInput.Code"
                                       autocomplete="one-time-code" inputmode="numeric" />
                            <ValidationMessage For="() => CodeInput.Code" class="text-danger small" />
                        </div>

                        <button type="submit" class="btn btn-primary">Подтвердить</button>
                        <a class="btn btn-link" href="/integrations">Отмена</a>
                    </EditForm>
                }
                else if (Step == StepPassword)
                {
                    <p class="text-body-secondary small">На аккаунте включена двухфакторная защита.</p>

                    <EditForm Model="PasswordInput" method="post" OnValidSubmit="SubmitPasswordAsync" FormName="submit-password">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label for="tfa" class="form-label">Пароль</label>
                            <InputText id="tfa" type="password" class="form-control" @bind-Value="PasswordInput.Password"
                                       autocomplete="current-password" />
                            <ValidationMessage For="() => PasswordInput.Password" class="text-danger small" />
                        </div>

                        <button type="submit" class="btn btn-primary">Войти</button>
                        <a class="btn btn-link" href="/integrations">Отмена</a>
                    </EditForm>
                }
                else
                {
                    <EditForm Model="PhoneInput" method="post" OnValidSubmit="BeginLoginAsync" FormName="begin-login">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label for="phone" class="form-label">Номер телефона</label>
                            <InputText id="phone" class="form-control" @bind-Value="PhoneInput.PhoneNumber" />
                            <ValidationMessage For="() => PhoneInput.PhoneNumber" class="text-danger small" />
                            <div class="form-text">
                                Рабочий номер, к которому привязан Telegram. Подставлен из вашего профиля.
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary">Получить код</button>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private const string StepCode = "code";
    private const string StepPassword = "password";

    private List<MessengerAccount> _accounts = [];
    private Guid _managerId;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "step")]
    public string? Step { get; set; }

    [SupplyParameterFromQuery(Name = "loginId")]
    public Guid? LoginId { get; set; }

    /// <summary>
    /// Сообщение едет кодом, а не текстом: подставить в адрес произвольную строку
    /// и прислать коллеге ссылку с выдуманным уведомлением не получится.
    /// </summary>
    [SupplyParameterFromQuery(Name = "notice")]
    public string? Notice { get; set; }

    private PhoneForm? _phoneForm;
    private CodeForm? _codeForm;
    private PasswordForm? _passwordForm;

    // Имя свойства обязано совпадать с тем, что стоит в разметке: из него Blazor
    // собирает префикс полей формы. Если связать «_codeForm», а в InputText
    // написать «CodeInput.Code», поле уедет на сервер под чужим именем
    // и молча не свяжется — форма отправится пустой.
    [SupplyParameterFromForm(FormName = "begin-login")]
    private PhoneForm PhoneInput
    {
        get => _phoneForm ??= new PhoneForm();
        set => _phoneForm = value;
    }

    [SupplyParameterFromForm(FormName = "submit-code")]
    private CodeForm CodeInput
    {
        get => _codeForm ??= new CodeForm();
        set => _codeForm = value;
    }

    [SupplyParameterFromForm(FormName = "submit-password")]
    private PasswordForm PasswordInput
    {
        get => _passwordForm ??= new PasswordForm();
        set => _passwordForm = value;
    }

    protected override async Task OnInitializedAsync()
    {
        _managerId = HttpContext.User.GetManagerId() ?? Guid.Empty;
        _accounts = await Accounts.GetAccountsAsync(_managerId);

        if (string.IsNullOrWhiteSpace(PhoneInput.PhoneNumber))
        {
            PhoneInput.PhoneNumber = _accounts
                .FirstOrDefault(account => account.Platform == MessengerPlatform.Telegram)?.PhoneNumber
                ?? HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.MobilePhone)?.Value
                ?? string.Empty;
        }
    }

    private async Task BeginLoginAsync()
    {
        var (loginId, step) = await Accounts.BeginLoginAsync(
            _managerId, MessengerPlatform.Telegram, PhoneInput.PhoneNumber, ClientIp);

        GoTo(loginId, step);
    }

    private Task SubmitCodeAsync() => ContinueAsync(new LoginAnswer.VerificationCode(CodeInput.Code));

    private Task SubmitPasswordAsync() => ContinueAsync(new LoginAnswer.TwoFactorPassword(PasswordInput.Password));

    private async Task ContinueAsync(LoginAnswer answer)
    {
        var (loginId, step) = await Accounts.ContinueLoginAsync(
            _managerId, LoginId ?? Guid.Empty, answer, ClientIp);

        GoTo(loginId, step);
    }

    private async Task DisconnectAsync(Guid accountId)
    {
        await Accounts.DisconnectAsync(_managerId, accountId, ClientIp);

        Navigation.NavigateTo("/integrations?notice=disconnected");
    }

    /// <summary>
    /// Переход на следующий шаг отдельным запросом. Так обновление страницы
    /// не повторяет отправку формы, а Blazor на следующем запросе рисует нужную
    /// форму до того, как начнёт искать её по имени.
    /// </summary>
    private void GoTo(Guid loginId, LoginStep step)
    {
        var target = step switch
        {
            LoginStep.NeedsVerificationCode => $"/integrations?loginId={loginId}&step={StepCode}",
            LoginStep.NeedsTwoFactorPassword => $"/integrations?loginId={loginId}&step={StepPassword}",
            LoginStep.Completed => "/integrations?notice=connected",
            LoginStep.Failed failed => $"/integrations?notice={NoticeFor(failed)}",
            _ => "/integrations",
        };

        Navigation.NavigateTo(target);
    }

    private static string NoticeFor(LoginStep.Failed failed) => failed switch
    {
        { Details: { } details } when details.Contains("не настроен", StringComparison.Ordinal) => "notconfigured",
        { Details: { } details } when details.Contains("уже подключён", StringComparison.Ordinal) => "alreadyconnected",
        _ => failed.Reason.ToString().ToLowerInvariant(),
    };

    private static bool IsError(string notice) => notice is not ("connected" or "disconnected");

    private static string NoticeText(string notice) => notice switch
    {
        "connected" => "Telegram подключён",
        "disconnected" => "Канал отключён",
        "notconfigured" => "Telegram не настроен на сервере — обратитесь к администратору",
        "alreadyconnected" => "Этот канал уже подключён",
        "invalidphonenumber" => "Номер телефона в нераспознанном формате",
        "invalidcode" => "Неверный код подтверждения",
        "invalidpassword" => "Неверный пароль двухфакторной защиты",
        "expired" => "Попытка подключения устарела, начните заново",
        "ratelimited" => "Telegram временно ограничил попытки. Подождите и повторите",
        "accountbanned" => "Аккаунт заблокирован платформой",
        "networkerror" => "Нет связи с Telegram. Проверьте настройки прокси",
        _ => "Не удалось подключить канал",
    };

    private string? ClientIp => HttpContext.Connection.RemoteIpAddress?.ToString();

    private static string StatusText(MessengerAccountStatus status) => status switch
    {
        MessengerAccountStatus.Active => "Работает",
        MessengerAccountStatus.PendingAuth => "Вход не завершён",
        MessengerAccountStatus.Disconnected => "Отключён",
        MessengerAccountStatus.RequiresReauth => "Требуется повторный вход",
        _ => status.ToString(),
    };

    private sealed class PhoneForm
    {
        [Required(ErrorMessage = "Укажите номер телефона")]
        public string PhoneNumber { get; set; } = string.Empty;
    }

    private sealed class CodeForm
    {
        [Required(ErrorMessage = "Введите код из Telegram")]
        public string Code { get; set; } = string.Empty;
    }

    private sealed class PasswordForm
    {
        [Required(ErrorMessage = "Введите пароль")]
        public string Password { get; set; } = string.Empty;
    }
}
