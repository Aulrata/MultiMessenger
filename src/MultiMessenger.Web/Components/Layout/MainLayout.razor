@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-end align-items-center gap-3">
            <AuthorizeView>
                <Authorized>
                    <span class="text-body-secondary small">@context.User.GetFullName()</span>
                    @* Выход только POST-ом с токеном: по GET-ссылке чужая страница
                       могла бы разлогинить сотрудника обычной картинкой. *@
                    <form action="@AuthenticationSetup.LogoutPath" method="post">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-sm btn-link text-decoration-none">Выйти</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Произошла непредвиденная ошибка.
    <a href="." class="reload">Обновить</a>
    <span class="dismiss">🗙</span>
</div>
