{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        // Свой код — подробно: именно его и отлаживаем.
        "MultiMessenger": "Debug",

        "Microsoft.AspNetCore": "Warning",

        // EF на Debug заливает консоль двумя десятками строк на каждый запрос:
        // открытие соединения, отслеживание сущностей, закрытие. Очередь
        // исходящих опрашивает базу каждые две секунды, и читать лог становится
        // невозможно. Чтобы посмотреть SQL, поднять Database.Command до Information.
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },

  "Minio": {
    "UseSsl": false
  }
}
