# Шаблон переменных окружения для локального docker-compose.
# Скопировать в .env и при необходимости поправить: cp .env.example .env
#
# .env в репозиторий не коммитится. Для сервера есть отдельный шаблон —
# deploy/.env.example, набор переменных там другой.

# --- PostgreSQL ---
POSTGRES_DB=multimessenger
POSTGRES_USER=multimessenger
POSTGRES_PASSWORD=change_me_locally
# Если 5432 уже занят другим PostgreSQL (локальной установкой или контейнером
# от соседнего проекта) — поставить свободный порт, например 5433.
POSTGRES_PORT=5432

# --- MinIO ---
# Пароль должен быть не короче 8 символов, иначе контейнер не стартует.
MINIO_ROOT_USER=multimessenger
MINIO_ROOT_PASSWORD=change_me_locally
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Seq (просмотр логов) ---
# Поднимается отдельно: docker compose --profile observability up -d
SEQ_UI_PORT=5341
SEQ_ADMIN_PASSWORD=change_me_locally

# --- Приложение в контейнере ---
# Нужно только для профиля app: docker compose --profile app up -d
# При разработке приложение обычно запускается через dotnet run и эти
# переменные не используются.
APP_PORT=8080
SEED_ADMIN_PHONE=+79001112233
SEED_ADMIN_PASSWORD=change_me_locally
