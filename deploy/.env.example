# Шаблон боевых переменных. Кладётся на сервер рядом с docker-compose.prod.yml
# под именем .env, заполняется вручную и в репозиторий не попадает.
#
#   cp .env.example .env && chmod 600 .env
#
# Пароли должны быть новыми, а не скопированными из локального окружения.
# Сгенерировать: openssl rand -base64 24

# --- Порт приложения ---
# Публикуется только на 127.0.0.1, наружу его выставляет обратный прокси.
# На сервере уже заняты 8080 (romantour-app) и 8081 (romantour-test-app),
# поэтому берём следующий свободный. Проверить: sudo ss -tlnp | grep 8082
APP_PORT=8082

# --- PostgreSQL ---
# Наружу не публикуется, доступен только внутри docker-сети стека.
POSTGRES_DB=multimessenger
POSTGRES_USER=multimessenger
POSTGRES_PASSWORD=

# --- MinIO ---
# Тоже без публикации портов. Пароль не короче 8 символов.
MINIO_ROOT_USER=multimessenger
MINIO_ROOT_PASSWORD=

# --- Первый администратор ---
# Применяется один раз, пока в базе нет ни одного сотрудника.
# После первого входа строки можно удалить.
SEED_ADMIN_PHONE=+7
SEED_ADMIN_PASSWORD=

# --- Telegram (понадобится на этапе 2) ---
# Получить на my.telegram.org. Один api_id на весь сервис: аккаунты
# изолируются разными файлами сессий, а не разными приложениями.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Seq (необязательно) ---
# Пусто — приложение пишет логи только в файлы и в docker logs.
SEQ_SERVER_URL=
