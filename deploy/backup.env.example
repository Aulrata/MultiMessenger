# Настройки резервного копирования. Скопировать в backup.env рядом со скриптом.
# Значения POSTGRES_* и MINIO_* подхватываются из основного .env, дублировать не нужно.

# Где складываются копии перед отправкой
BACKUP_ROOT=/var/backups/multimessenger

# Сколько дней хранить локально
BACKUP_KEEP_DAYS=14

# Куда уезжает копия. Обязательный параметр: без него скрипт завершится ошибкой,
# потому что копия рядом с данными не защищает ни от чего.
# Примеры:
#   BACKUP_REMOTE=backup@nas.example.com:/volume1/multimessenger
#   BACKUP_REMOTE=user@second-vps.example.com:/srv/backups/multimessenger
BACKUP_REMOTE=

# Ключ для доступа к хранилищу копий. Отдельный от деплойного и без парольной фразы.
BACKUP_SSH_KEY=/root/.ssh/id_backup

# Имя тома с файлами сессий. Складывается из имени compose-проекта и имени тома;
# проверить — docker volume ls
SESSIONS_VOLUME=multimessenger_sessions
