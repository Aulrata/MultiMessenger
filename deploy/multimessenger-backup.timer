[Unit]
Description=Ежедневное резервное копирование MultiMessenger

[Timer]
# 03:30 по времени сервера — переписки в это время почти нет.
OnCalendar=*-*-* 03:30:00

# Если сервер был выключен в назначенное время, копия снимется при следующем запуске.
Persistent=true

# Разброс до пяти минут, чтобы копирование не совпадало с другими ночными задачами.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
